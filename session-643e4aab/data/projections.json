  "assumptions": [
   {
    "name": "cap_subject",
    "value": "6.25% base; tested 4.50%-7.25%",
    "rationale": "No official source publishes asset-level cap rates - metric C04 is deliberately blank. The base sits above the verified 4.84-4.90% 10-year Treasury plus a single-tenant risk premium. The band, not the point, is the answer."
   },
   {
    "name": "cap_replacement",
    "value": "6.50%",
    "rationale": "The replacement asset bought with sale proceeds. Set 25 bp ABOVE the subject's cap so the sell path is not flattered by assuming the owner can buy the same yield with less concentration. Net-lease portfolios do trade at tighter caps than a single asset, so 6.50% is conservative."
   },
   {
    "name": "growth",
    "value": "Bear 1.0% / Base 2.0% / Bull 3.7%",
    "rationale": "Applied identically to the subject and to the replacement, so it cancels except where term differs. Bull equals the verified LA CPI-U year-over-year rate (W03), i.e. a fully indexed escalation. Base is a typical fixed NNN escalator, deliberately BELOW verified CPI so the base case does not flatter holding."
   },
   {
    "name": "reset_uplift",
    "value": "+8.0% at extension",
    "rationale": "Mark-to-market at renewal. Set just above the breakeven the model computes, and stress-tested at 0% and 15%, so the recommendation is not created by this assumption."
   },
   {
    "name": "renew_prob",
    "value": "60%",
    "rationale": "The tenant's own renewal practice could not be re-verified this session (metric N12 is blank). 60% is a neutral prior; the Monte Carlo draws 40%-85%."
   },
   {
    "name": "vacancy_months / relet_discount",
    "value": "9 months / -5%",
    "rationale": "Downtime and a below-renewal re-let price if the tenant leaves. Typical for a purpose-built QSR box that must be re-permitted and re-fitted."
   },
   {
    "name": "disposition cost",
    "value": "3.00% brokerage + 0.50% closing + statutory transfer taxes",
    "rationale": "Brokerage and closing are judgment. The taxes are the verified statutory stack: 0.11% county (S10), 0.45% City base (S11) and Measure ULA 4%/5.5% above $5.4M/$10.9M (S11)."
